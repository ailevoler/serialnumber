diff -ruN zip1/marketplace/migrations/20261015_lot_incentives.sql work/marketplace/migrations/20261015_lot_incentives.sql
--- zip1/marketplace/migrations/20261015_lot_incentives.sql	1970-01-01 00:00:00.000000000 +0000
+++ work/marketplace/migrations/20261015_lot_incentives.sql	2026-10-15 09:50:01.270489300 +0000
@@ -0,0 +1,24 @@
+-- Lot completion incentives ("Choose Your Plan and Get Your Bonus").
+-- Import after 20261015_lot_referral_bonus.sql.
+-- cash_lot_plans.incentive_minor / incentive_invites: incentive in USD cents paid when a purchased Lot completes,
+--   and the number of invited Traders (registered via the buyer's link and bought a Lot before the buyer's Lot ends) required.
+-- cash_lots: snapshot of those terms at purchase plus the one-time settlement result.
+-- Lots purchased before this update keep 0 incentive (no retroactive credits).
+-- The app also adds these columns automatically if this file is not imported.
+
+ALTER TABLE cash_lot_plans
+  ADD COLUMN IF NOT EXISTS incentive_minor BIGINT UNSIGNED NOT NULL DEFAULT 0,
+  ADD COLUMN IF NOT EXISTS incentive_invites INT UNSIGNED NOT NULL DEFAULT 0;
+
+ALTER TABLE cash_lots
+  ADD COLUMN IF NOT EXISTS incentive_minor BIGINT UNSIGNED NOT NULL DEFAULT 0,
+  ADD COLUMN IF NOT EXISTS incentive_invites INT UNSIGNED NOT NULL DEFAULT 0,
+  ADD COLUMN IF NOT EXISTS incentive_status VARCHAR(12) NULL DEFAULT NULL,
+  ADD COLUMN IF NOT EXISTS incentive_invites_counted INT UNSIGNED NULL DEFAULT NULL,
+  ADD COLUMN IF NOT EXISTS incentive_request_id BIGINT UNSIGNED NULL DEFAULT NULL,
+  ADD COLUMN IF NOT EXISTS incentive_settled_at DATETIME NULL DEFAULT NULL;
+
+-- Client promo: 60 days $60 + invite 3 · 75 days $200 + invite 8 · 90 days $480, no invites.
+UPDATE cash_lot_plans SET incentive_minor=6000,  incentive_invites=3 WHERE incentive_minor=0 AND (name='Lot 4' OR (price_minor=48000  AND name NOT IN ('Lot 1','Lot 2','Lot 3','Lot 5','Lot 6')));
+UPDATE cash_lot_plans SET incentive_minor=20000, incentive_invites=8 WHERE incentive_minor=0 AND (name='Lot 5' OR (price_minor=100000 AND name NOT IN ('Lot 1','Lot 2','Lot 3','Lot 4','Lot 6')));
+UPDATE cash_lot_plans SET incentive_minor=48000, incentive_invites=0 WHERE incentive_minor=0 AND (name='Lot 6' OR (price_minor=180000 AND name NOT IN ('Lot 1','Lot 2','Lot 3','Lot 4','Lot 5')));
diff -ruN zip1/marketplace/migrations/20261015_lot_referral_bonus.sql work/marketplace/migrations/20261015_lot_referral_bonus.sql
--- zip1/marketplace/migrations/20261015_lot_referral_bonus.sql	1970-01-01 00:00:00.000000000 +0000
+++ work/marketplace/migrations/20261015_lot_referral_bonus.sql	2026-10-15 09:33:30.816977294 +0000
@@ -0,0 +1,20 @@
+-- Per-Lot referral bonus percentage.
+-- Import after 20260925_client_adjustments.sql.
+-- cash_lot_plans.referral_bps: referral % for this package in basis points (500 = 5.00%); NULL uses the global referral setting.
+-- cash_lots.referral_bps: snapshot taken at purchase so later package edits never change a bought Lot's bonus.
+-- The app also adds these columns automatically if this file is not imported.
+
+ALTER TABLE cash_lot_plans ADD COLUMN IF NOT EXISTS referral_bps INT UNSIGNED NULL DEFAULT NULL;
+ALTER TABLE cash_lots ADD COLUMN IF NOT EXISTS referral_bps INT UNSIGNED NULL DEFAULT NULL;
+
+-- Client referral bonus per Lot: Lot 1=5%, Lot 2=10%, Lot 3=10%, Lot 4=15%, Lot 5=15%, Lot 6=20%.
+UPDATE cash_lot_plans SET referral_bps = CASE name
+  WHEN 'Lot 1' THEN 500 WHEN 'Lot 2' THEN 1000 WHEN 'Lot 3' THEN 1000
+  WHEN 'Lot 4' THEN 1500 WHEN 'Lot 5' THEN 1500 WHEN 'Lot 6' THEN 2000 END
+WHERE referral_bps IS NULL AND name IN ('Lot 1','Lot 2','Lot 3','Lot 4','Lot 5','Lot 6');
+
+-- Same percentages for packages not named "Lot N" but still at the original Lot prices ($40 … $1,800).
+UPDATE cash_lot_plans SET referral_bps = CASE price_minor
+  WHEN 4000 THEN 500 WHEN 8000 THEN 1000 WHEN 18000 THEN 1000
+  WHEN 48000 THEN 1500 WHEN 100000 THEN 1500 WHEN 180000 THEN 2000 END
+WHERE referral_bps IS NULL AND price_minor IN (4000, 8000, 18000, 48000, 100000, 180000);
